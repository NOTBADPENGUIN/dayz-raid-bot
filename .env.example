# Token du bot Discord (obtenu sur https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token

# ID du serveur Discord
GUILD_ID=your_guild_id

# ID du salon où envoyer les alertes
ALERT_CHANNEL_ID=your_alert_channel_id

# Port du serveur webhook local
WEBHOOK_PORT=3000

# Secret webhook (optionnel, pour sécuriser les requêtes entrantes)
WEBHOOK_SECRET=your_webhook_secret

# --- Optionnel : appels téléphoniques via Twilio ---
TWILIO_SID=your_twilio_account_sid
TWILIO_TOKEN=your_twilio_auth_token
TWILIO_FROM=+1234567890
PHONE_NUMBERS=+33600000000,+33700000000
